# Settings for development. Copy this file to .env, which git ignores: npm run dev and
# npm run dev:mailer read it. docs/development.md lists every setting.

# Accounts with email: the server's secret, which fingerprints email addresses, and the mailer,
# which here prints the mails, links included, instead of sending them.
SERVER_SECRET=development-only-secret-not-for-production
MAILER_SOCKET=data/mailer.sock
MAILER_TRANSPORT=print
MAILER_BASE_URL=http://localhost:5173

# npm run dev serves plain HTTP, where a browser drops a Secure cookie from anywhere but localhost.
COOKIE_SECURE=0
