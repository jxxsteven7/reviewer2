# Settings for development. Copy this file to .env, which git ignores: npm run dev,
# npm run dev:mailer and npm run dev:agent read it. docs/development.md lists every setting.

# Accounts with email: the server's secret, which fingerprints email addresses, and the mailer,
# which here prints the mails, links included, instead of sending them.
SERVER_SECRET=development-only-secret-not-for-production
MAILER_SOCKET=data/mailer.sock
MAILER_TRANSPORT=print
MAILER_BASE_URL=http://localhost:5173

# npm run dev serves plain HTTP, where a browser drops a Secure cookie from anywhere but localhost.
COOKIE_SECURE=0

# AI players: the agent, which asks a language model that answers OpenAI's chat completions, such
# as one that Ollama runs; npm run dev:agent starts it. Uncomment with a model that you have.
# AGENT_SOCKET=data/agent.sock
# AGENT_MODEL_URL=http://127.0.0.1:11434/v1
# AGENT_MODEL=your-model
