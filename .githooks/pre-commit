#!/bin/sh
# Refuse commits on main. Do your work in your own worktree and branch; see docs/rules/git.md.
# Then check the staged files for the name of the board game the first game is based on, which
# must not appear anywhere; see docs/rules/constraints.md.

branch=$(git symbolic-ref --short -q HEAD)

if [ "$branch" = "main" ]; then
  cat >&2 <<'EOF'
Commits on main are not allowed. Create a worktree and branch for this work, for example:

  git fetch origin
  git worktree add ../feat-xxx -b feat/xxx origin/main

If you have already changed files here, run git stash, then run git stash pop inside the new worktree.
See docs/rules/git.md.
EOF
  exit 1
fi

if [ ! -f scripts/check-names.mjs ]; then
  exit 0 # a branch that predates the check
fi

if ! command -v node >/dev/null 2>&1; then
  echo "The pre-commit hook needs Node.js to check the staged files. Install 24.15 or later, but not 25; see docs/development.md." >&2
  exit 1
fi

exec node scripts/check-names.mjs staged
