#!/bin/sh
# Check the commit message against the convention in docs/rules/git.md: the subject format,
# English only, no AI or agent attribution, and no version prefix on branch commits. The message
# must not contain the name of the board game the first game is based on either
# (docs/rules/constraints.md).
# The rules themselves live in scripts/check-commits.mjs, which CI runs as well.

if [ ! -f scripts/check-commits.mjs ]; then
  exit 0 # a branch that predates the checker
fi

if ! command -v node >/dev/null 2>&1; then
  echo "The commit-msg hook needs Node.js to check your commit message. Install 22.13 or later, but not 23 or 25; see docs/development.md." >&2
  exit 1
fi

exec node scripts/check-commits.mjs msg "$1"
